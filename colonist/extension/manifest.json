{
  "manifest_version": 3,
  "name": "Catanbot",
  "version": "1.0",
  "description": "Connects Catanbot MCTS engine to Colonist.io via WebSocket interception.",

  "permissions": ["storage", "tabs"],

  "content_scripts": [
    {
      "matches": ["*://colonist.io/*", "*://*.colonist.io/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://colonist.io/*", "*://*.colonist.io/*"]
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Catanbot"
  }
}
